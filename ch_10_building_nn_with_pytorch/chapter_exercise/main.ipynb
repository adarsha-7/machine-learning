   "source": [
    "import torch\n",
    "\n",
    "def f(x, y):\n",
    "    return torch.sin((x ** 2) * y)\n",
    "\n",
    "x = torch.tensor(1.2, requires_grad=True)\n",
    "y = torch.tensor(3.4, requires_grad=True)\n",
    "\n",
    "result = f(x, y)\n",
    "\n",
    "result.backward()\n",
    "\n",
    "print(f\"Gradient Vector of f: [{x.grad.item(), y.grad.item()}]\",)"
   ]
  }
 ],
